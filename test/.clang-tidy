---
# Tests spell out prices, quantities and ids inline, because naming each one
# would hide the case being tested, and a Google Test fixture keeps its
# members protected so the TYPED_TESTs can reach them.
InheritParentConfig: true
Checks: '-cppcoreguidelines-avoid-magic-numbers,-readability-magic-numbers,-readability-identifier-length,-readability-function-cognitive-complexity,-cppcoreguidelines-non-private-member-variables-in-classes,-misc-non-private-member-variables-in-classes'
